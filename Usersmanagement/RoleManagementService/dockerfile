# Etapa de construcción
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

# Copiar el archivo .csproj con su estructura
COPY RoleManagementService/RoleManagementService/RoleManagementService.csproj ./RoleManagementService/
WORKDIR /app/RoleManagementService
RUN dotnet restore

# Copiar todo el código fuente
WORKDIR /app
COPY RoleManagementService/RoleManagementService/. ./RoleManagementService/

# Publicar
WORKDIR /app/RoleManagementService
RUN dotnet publish -c Release -o /app/out

# Imagen final
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/out ./

EXPOSE 80
ENTRYPOINT ["dotnet", "RoleManagementService.dll"]
