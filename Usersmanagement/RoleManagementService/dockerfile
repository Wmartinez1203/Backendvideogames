# Use an official .NET SDK image to build the app
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

# Copy the .csproj file
COPY ./RoleManagementService.csproj ./

# Restore dependencies
RUN dotnet restore RoleManagementService.csproj

# Copy the entire project
COPY . ./

# Publish the application
RUN dotnet publish RoleManagementService.csproj -c Release -o out

# Build the runtime image
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/out ./

# Expose container port (matches Program.cs default unless overridden by env)
EXPOSE 80

# Run the app
ENTRYPOINT ["dotnet", "RoleManagementService.dll"]
